#!/usr/bin/env bash

# Update-cost preview: prices a prospective input update without applying it.
#
# Answers "if I ran nix flake update and rebuilt, what would it cost?" by
# resolving a temporary lock file and asking nix for a dry-run build plan.
# The real flake.lock is never written.
#
# Deliberately on demand only. A full system evaluation costs minutes and a
# lot of memory, so this runs when asked and never on a timer.

set -uo pipefail

FLAKE_DIR="${FLAKE_DIR:-${NIXOS_CONFIG_PATH:-$HOME/.config/nixos}}"
CACHE_DIR="${CACHE_DIR:-$HOME/.cache}"
PREVIEW_TARGET="${PREVIEW_TARGET:-.#nixosConfigurations.$(hostname).config.system.build.toplevel}"

PREVIEW_FILE="$CACHE_DIR/nix-update-preview"

# Shared with the background update check so the two never evaluate at once -
# each costs well over a gigabyte of RAM.
CHECK_LOCK_FILE="$CACHE_DIR/nix-update-check.lock"

# Fingerprint of what the last check found, recorded so a preview can expire
# when upstream moves - which leaves flake.lock and the current system
# untouched, and so is invisible to the other two staleness keys.
RESULT_HASH_FILE="$CACHE_DIR/nix-update-result-hash"

# Cleanup is registered at top level rather than inside the function that
# creates the directory: an EXIT trap runs after the function's locals are gone.
tempdir=""
cleanup() { [ -n "$tempdir" ] && rm -rf "$tempdir"; }
trap cleanup EXIT

refresh_waybar() {
    pkill -x -RTMIN+12 .waybar-wrapped >/dev/null 2>&1 || true
}

have_network() {
    ip route 2>/dev/null | grep -q "^default"
}

current_lock_hash() {
    sha256sum "$FLAKE_DIR/flake.lock" 2>/dev/null | cut -d' ' -f1
}

current_system_path() {
    readlink -f /run/current-system 2>/dev/null
}

current_result_hash() {
    cat "$RESULT_HASH_FILE" 2>/dev/null
}

# The state file is read by both checkers at output time. Values are written
# one per line as key=value; cost is last because it is the only free-form one.
write_state() {
    local status="$1" cost="${2:-}" reason="${3:-}" owner="${4:-}"
    mkdir -p "$CACHE_DIR"
    {
        printf 'status=%s\n' "$status"
        printf 'timestamp=%s\n' "$(date +%s)"
        printf 'lock_hash=%s\n' "$(current_lock_hash)"
        printf 'system_path=%s\n' "$(current_system_path)"
        printf 'result_hash=%s\n' "$(current_result_hash)"
        # "<pid> <starttime> <boot id>" of the evaluating process while status
        # is calculating, so a reader can tell a live evaluation from one that
        # died without recording anything. The boot id is part of the identity
        # because starttime is counted from boot and so repeats across one.
        # Empty in every other state.
        printf 'owner=%s\n' "$owner"
        printf 'reason=%s\n' "$reason"
        printf 'cost=%s\n' "$cost"
    } > "$PREVIEW_FILE"
}

# Turns nix's dry-run plan into a single line. The counts exist only as
# human-readable text - nix build --dry-run --json reports the top-level
# derivation and nothing about what would be built or fetched - so this scrapes
# stderr. A format change must therefore read as "unavailable" and never as a
# plausible-looking zero.
# Nix records no build durations, but it does record when each path became
# valid. The gap between consecutive locally-built paths approximates how long
# that derivation took, and the same for substituted paths gives an effective
# download rate. Both are read from this machine's own store, so the estimate
# calibrates itself to this CPU, disk and link rather than to shipped constants.
NIX_DB="${NIX_DB:-/nix/var/nix/db/db.sqlite}"

# Gaps longer than this are treated as a boundary between sessions rather than
# one very slow derivation, and excluded from both history and rates.
ESTIMATE_GAP_CAP="${ESTIMATE_GAP_CAP:-300}"

# Effective substitution rate in MiB of nar per second, measured over the whole
# span of a past download session. Deliberately not raw link speed: the span
# includes the building that happens between fetches, which is what makes it
# predict wall clock rather than transfer time.
substitution_rate() {
    command -v sqlite3 >/dev/null 2>&1 || return 1
    sqlite3 "$NIX_DB" "
        WITH s AS (
          SELECT registrationTime AS t, narSize,
                 registrationTime - LAG(registrationTime) OVER (ORDER BY registrationTime) AS gap
          FROM ValidPaths WHERE ultimate IS NULL OR ultimate = 0)
        SELECT ROUND(SUM(narSize)/1048576.0 / NULLIF(SUM(gap),0), 3)
        FROM s WHERE gap IS NOT NULL AND gap <= $ESTIMATE_GAP_CAP;" 2>/dev/null
}

# Sum of median historical build times for the given derivation names, plus how
# many of them had any history at all. A derivation never built here contributes
# nothing and is counted as unseen, rather than being guessed at.
build_estimate() {
    local names_file="$1"
    command -v sqlite3 >/dev/null 2>&1 || return 1
    [ -s "$names_file" ] || return 1

    # pname key: drop the trailing version so a new release matches past builds
    # of the same package. Inlined as VALUES rather than imported: sqlite3
    # flattens dot-commands when SQL arrives as an argument, so .import cannot
    # be used here.
    local values
    values=$(sed -E "s/-[0-9][0-9a-zA-Z.+_-]*$//; s/'/''/g; s/^(.*)$/('\1'),/" "$names_file" \
             | sort -u | tr -d '\n' | sed 's/,$//')
    [ -n "$values" ] || return 1

    sqlite3 "$NIX_DB" "
        CREATE TEMP TABLE want(pname TEXT);
        INSERT INTO want(pname) VALUES $values;
        CREATE TEMP TABLE hist AS
        WITH b AS (
          SELECT substr(path,45) AS name,
                 registrationTime - LAG(registrationTime) OVER (ORDER BY registrationTime) AS gap
          FROM ValidPaths WHERE ultimate = 1)
        SELECT name, gap FROM b WHERE gap IS NOT NULL AND gap <= $ESTIMATE_GAP_CAP;
        CREATE TEMP TABLE m AS
        WITH j AS (
          SELECT DISTINCT w.pname AS pname, h.gap AS gap
          FROM (SELECT DISTINCT pname FROM want) w
          JOIN hist h ON h.name LIKE w.pname || '-%' OR h.name = w.pname),
        r AS (
          SELECT pname, gap,
                 ROW_NUMBER() OVER (PARTITION BY pname ORDER BY gap) rn,
                 COUNT(*)     OVER (PARTITION BY pname)            c
          FROM j)
        SELECT pname, MIN(gap) AS med FROM r WHERE rn = (c+1)/2 GROUP BY pname;
        SELECT COALESCE(SUM(m.med),0) || '|' || COUNT(m.pname) || '|' || (SELECT COUNT(*) FROM want)
        FROM want w LEFT JOIN m ON m.pname = w.pname;
    " 2>/dev/null
}

# "1h 5m", "12m", "45s" - a duration nobody has to convert in their head.
human_duration() {
    local s="$1"
    [ "$s" -lt 60 ] 2>/dev/null && { printf '%ds' "$s"; return; }
    if [ "$s" -lt 3600 ]; then printf '%dm' "$((s/60))"; return; fi
    printf '%dh %dm' "$((s/3600))" "$(((s%3600)/60))"
}

summarise_plan() {
    local plan="$1"
    local builds fetches sizes

    builds=$(sed -nE 's/^these ([0-9]+) derivations? will be built:$/\1/p; s/^this derivation will be built:$/1/p' <<<"$plan" | tail -1)
    fetches=$(sed -nE 's/^these ([0-9]+) paths? will be fetched.*$/\1/p; s/^this path will be fetched.*$/1/p' <<<"$plan" | tail -1)
    sizes=$(sed -nE 's/^these [0-9]+ paths? will be fetched \((.*)\):$/\1/p; s/^this path will be fetched \((.*)\):$/\1/p' <<<"$plan" | tail -1)

    # nix omits both lines when there is genuinely nothing to do. That is a
    # real answer, and a different one from failing to understand the output.
    if [ -z "$builds" ] && [ -z "$fetches" ]; then
        if grep -q "will be built\|will be fetched" <<<"$plan"; then
            return 1  # the lines are there but did not parse
        fi
        printf 'nothing to build or download'
        return 0
    fi

    # Download leads, because it dominates: a measured rebuild spent 30 of its
    # 43 minutes fetching and only 13 building.
    # A literal backslash-n, not a real newline: this ends up in a key=value
    # state file that is read a line at a time, and the tooltip renders the
    # escape as a break anyway.
    local out=""
    local est
    if est=$(estimate_line "$plan"); then
        [ -n "$est" ] && out="$est"'\n'
    fi

    # Download before build, matching the order the work actually happens in:
    # measured here, fetching started 769s before the first build. The sizes
    # stay attached to the download half, which is what they describe.
    out+="${fetches:-0} to download"
    [ -n "$sizes" ] && out+=" ($sizes)"
    out+=" · ${builds:-0} to build"
    printf '%s' "$out"
}

# Turns the plan into "~32m download · ~13m build (62 of 105 seen)". Any part
# that cannot be estimated is omitted rather than guessed, and the whole line is
# dropped if nothing can be worked out at all.
estimate_line() {
    local plan="$1"
    local parts=()

    # Download: unpacked bytes over the measured rate. Both are nar-domain, so
    # the compression ratio cancels and never has to be assumed.
    local unpacked rate
    unpacked=$(sed -nE 's/.*will be fetched \(.*, ([0-9.]+) ([KMG])iB unpacked\):$/\1 \2/p' <<<"$plan" | tail -1)
    rate=$(substitution_rate)
    if [ -n "$unpacked" ] && [ -n "$rate" ]; then
        local n unit mib
        read -r n unit <<<"$unpacked"
        case "$unit" in
            K) mib=$(awk -v n="$n" 'BEGIN{printf "%.3f", n/1024}') ;;
            M) mib="$n" ;;
            G) mib=$(awk -v n="$n" 'BEGIN{printf "%.3f", n*1024}') ;;
        esac
        local secs
        secs=$(awk -v m="$mib" -v r="$rate" 'BEGIN{ if (r>0) printf "%d", m/r }')
        [ -n "$secs" ] && [ "$secs" -gt 0 ] 2>/dev/null && \
            parts+=("~$(human_duration "$secs") download")
    fi

    # Build: sum of median historical times, with coverage stated. A low
    # coverage figure is the reader's cue that the number is a floor.
    local names
    names=$(mktemp)
    grep -oE '/nix/store/[a-z0-9]{32}-[^ ]*\.drv' <<<"$plan" \
        | sed 's|.*/[a-z0-9]\{32\}-||; s|\.drv$||' | sort -u > "$names"
    if [ -s "$names" ]; then
        local res
        if res=$(build_estimate "$names") && [ -n "$res" ]; then
            local bsecs seen total
            IFS='|' read -r bsecs seen total <<<"$res"
            if [ "${bsecs:-0}" -gt 0 ] 2>/dev/null; then
                parts+=("~$(human_duration "$bsecs") build ($seen of $total seen)")
            fi
        fi
    fi
    rm -f "$names"

    [ "${#parts[@]}" -eq 0 ] && return 1
    # Joined by hand: ${arr[*]} only ever uses the first character of IFS.
    local out="${parts[0]}" i
    for ((i = 1; i < ${#parts[@]}; i++)); do out+=" · ${parts[i]}"; done
    printf '%s' "$out"
}

run_preview() {
    if [ ! -f "$FLAKE_DIR/flake.lock" ]; then
        write_state failed "" "no flake.lock at $FLAKE_DIR"
        refresh_waybar
        return 1
    fi

    if ! have_network; then
        write_state failed "" "no network"
        refresh_waybar
        return 1
    fi

    tempdir=$(mktemp -d) || return 1

    # A leading "." means the configured flake, not the working directory:
    # this is invoked from waybar, whose cwd is arbitrary.
    local target="$PREVIEW_TARGET"
    case "$target" in
        .#*) target="$FLAKE_DIR#${target#.#}" ;;
    esac

    # Resolve an updated lock beside the real one rather than copying the tree.
    # --output-lock-file writes only the lock, so the configuration and its
    # working tree are untouched.
    local update_err
    if ! update_err=$(nix flake update --flake "$FLAKE_DIR" \
            --output-lock-file "$tempdir/flake.lock" 2>&1); then
        write_state failed "" "$(tail -1 <<<"$update_err")"
        refresh_waybar
        return 1
    fi

    local plan
    if ! plan=$(nix build --dry-run --reference-lock-file "$tempdir/flake.lock" \
            "$target" 2>&1 >/dev/null); then
        write_state failed "" "$(tail -1 <<<"$plan")"
        refresh_waybar
        return 1
    fi

    # Strip any ANSI nix may have emitted before matching on line starts.
    plan=$(sed $'s/\033\\[[0-9;]*m//g' <<<"$plan")

    local cost
    if ! cost=$(summarise_plan "$plan"); then
        write_state failed "" "unexpected nix output"
        refresh_waybar
        return 1
    fi

    write_state done "$cost"
    refresh_waybar
}

# Entry point used by the click binding: report immediately, evaluate detached.
start() {
    mkdir -p "$CACHE_DIR"

    # A check and a preview are each a full system evaluation. Decline rather
    # than queue, so a click never fires a job minutes after it was forgotten.
    if ! flock -n "$CHECK_LOCK_FILE" true 2>/dev/null; then
        write_state declined
        refresh_waybar
        return 0
    fi

    write_state calculating
    # Spawn before signalling waybar. The signal makes waybar re-poll, and that
    # poll can start an update check, which would take the lock this worker is
    # about to want.
    setsid -f "$0" worker </dev/null >/dev/null 2>&1 || true
    refresh_waybar
}

worker() {
    (
        # The launcher's lock test and this acquisition are separate moments, so
        # a check can start in between. Say so and clear the calculating state -
        # exiting quietly here left the tooltip reading "calculating..." forever,
        # because nothing else ever rewrites that record.
        if ! flock -n 9; then
            write_state declined
            refresh_waybar
            exit 0
        fi
        printf '%s %s\n' "$(($(ps -o pgid= -p $$)))" "$(date +%s)" >&9
        # Re-stamp with this process's identity so a reader can tell a running
        # evaluation from one that was killed part way through.
        write_state calculating "" "" \
            "$$ $(awk '{print $22}' /proc/$$/stat 2>/dev/null) $(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
        run_preview || true
    ) 9>"$CHECK_LOCK_FILE"
}

case "${1:-start}" in
    start)  start ;;
    worker) worker ;;
    run)    run_preview ;;   # synchronous, for terminal use
    clear)  rm -f "$PREVIEW_FILE"; refresh_waybar ;;
    *)      echo "usage: preview [start|run|clear]" >&2; exit 2 ;;
esac
