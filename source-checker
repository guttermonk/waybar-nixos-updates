#!/usr/bin/env bash

# Optional source-provenance checker for revisions that ordinary package and
# flake-input checks cannot interpret without an explicit upstream policy.

set -u

FLAKE_DIR="${FLAKE_DIR:-${NIXOS_CONFIG_PATH:-$HOME/.config/nixos}}"
# Deliberately ${VAR-default}, not ${VAR:-default}: only an *unset* value means
# "no checks configured". An empty value is a broken one, and must fall through
# to the validation below rather than being silently read as an empty list.
SOURCE_CHECKS_JSON="${SOURCE_CHECKS_JSON-[]}"

# Per-repository ceiling for git ls-remote. These run serially, one or more per
# configured check, inside the lock held by the background worker - an unbounded
# call against a slow or unreachable remote would stall every later check.
# ls-remote against a large repository (nixpkgs) measures around 46s, so the
# default leaves headroom without being open-ended.
SOURCE_CHECK_TIMEOUT="${SOURCE_CHECK_TIMEOUT:-60}"

# Ceiling for the nix eval behind current = "package". Reading one attribute
# out of an already-evaluated configuration measures around 4s warm; the
# ceiling is for the cold case, and stops a package whose expression loops or
# blocks from holding the worker lock open indefinitely.
PACKAGE_EVAL_TIMEOUT="${PACKAGE_EVAL_TIMEOUT:-120}"

json_result() {
    jq -cn --argjson count "$1" --argjson shown "$2" --arg tooltip "$3" \
        '{count: $count, shown: $shown, tooltip: $tooltip}'
}

have_network() {
    ip route 2>/dev/null | grep -q "^default"
}

# Wraps git ls-remote with a timeout and no credential prompting.
ls_remote() {
    GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="" \
        timeout "$SOURCE_CHECK_TIMEOUT" git ls-remote "$@" 2>/dev/null
}

remote_revision() {
    local repository="$1"
    local ref="$2"
    local remote_ref="$ref"
    [[ "$ref" == "HEAD" ]] || remote_ref="refs/heads/$ref"
    ls_remote "$repository" "$remote_ref" | awk 'NR == 1 { print $1 }'
}

# The upstream tag list, one bare tag per line. Fetched once per check and
# passed to latest_tag: the membership test below reads the same list, so a tag
# policy still costs a single ls-remote no matter how much is asked of it.
remote_tags() {
    ls_remote --tags --refs "$1" | awk '{ sub("refs/tags/", "", $2); print $2 }'
}

latest_tag() {
    local tags="$1"
    local include_pattern="$2"
    local excluded_json="$3"

    printf '%s\n' "$tags" \
        | while IFS= read -r tag; do
            [[ "$tag" == $include_pattern ]] || continue
            excluded=false
            while IFS= read -r pattern; do
                if [[ "$tag" == $pattern ]]; then
                    excluded=true
                    break
                fi
            done < <(jq -r '.[]' <<<"$excluded_json")
            [[ "$excluded" == false ]] && printf '%s\n' "$tag"
        done \
        | sort -V \
        | tail -n 1
}

flake_input_node() {
    local input="$1"
    jq -c --arg input "$input" '
        . as $lock
        | $lock.nodes.root.inputs[$input] as $reference
        | if ($reference | type) == "array" then $reference[0] else $reference end
        | $lock.nodes[.]
    ' "$FLAKE_DIR/flake.lock" 2>/dev/null
}

# Set by current_value(): the resolved current revision or tag.
CURRENT_VALUE=""
# Set by current_value() for current = "package": the upstream repository read
# out of the package's own src, used when the check does not name one itself.
DERIVED_REPOSITORY=""
# Set by current_value() when it fails, so a missing attribute, a src with no
# revision in it and a typo'd input name do not all report the same thing.
CURRENT_ERROR=""

# Set by current_value() when the revision was read out of a working tree that
# has uncommitted changes. What the system got built from is the tree, not the
# commit, so a HEAD that matches upstream is not the whole story - and a check
# that stayed silent on it would be claiming more than it knows.
CURRENT_DIRTY=false

# Set by current_value() wherever the current revision's commit time can be
# read without asking the network: a working tree has it in its own history,
# and flake.lock records lastModified for every locked input. Passed on to
# format-upstream-line, which would otherwise have to spend an API call
# establishing a date that was sitting on disk. Left empty for a hand-written
# pin and for a revision out of a package's src, which genuinely have no local
# source for it.
CURRENT_EPOCH=""

# Records whether a working tree has changes that are in no commit. Its own
# function so that the callers below can end on an explicit "return 0": a
# trailing "[[ ... ]] && CURRENT_DIRTY=true" would hand its own false status
# back as the caller's return value on every clean tree, turning a perfectly
# resolved revision into a reported failure.
note_worktree_dirty() {
    [[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]] && CURRENT_DIRTY=true
    return 0
}

# Revision of a git working tree, which is how a source gets its current value
# when the lock does not carry one: a local path override, or current =
# "local". Sets CURRENT_DIRTY as a side effect for the same reason
# current_value() sets its own globals rather than printing them.
worktree_revision() {
    local path="$1"
    [[ -n "$path" ]] || return 1
    git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
    CURRENT_VALUE=$(git -C "$path" rev-parse HEAD 2>/dev/null)
    [[ -n "$CURRENT_VALUE" ]] || return 1
    CURRENT_EPOCH=$(git -C "$path" log -1 --format=%ct HEAD 2>/dev/null) || CURRENT_EPOCH=""
    note_worktree_dirty "$path"
    return 0
}

# The same for a tag policy: the nearest tag reachable from HEAD, which is what
# the tree would call its own version.
worktree_tag() {
    local path="$1"
    [[ -n "$path" ]] || return 1
    CURRENT_VALUE=$(git -C "$path" describe --tags --abbrev=0 2>/dev/null)
    [[ -n "$CURRENT_VALUE" ]] || return 1
    note_worktree_dirty "$path"
    return 0
}

# Set by package_pin(): the rev, tag and repository read out of a package's src.
PACKAGE_PIN=""

# Attribute prefixes that hold a configuration's package set, tried in order.
# Resolved once per run and reused: probing costs a nix eval per candidate, and
# every package check after the first would otherwise pay for it again.
PACKAGE_BASE=""

package_bases() {
    if [[ -n "$PACKAGE_BASE" ]]; then
        printf '%s\n' "$PACKAGE_BASE"
        return
    fi

    # Read rather than shelled out to, because "hostname" comes from inetutils
    # and only one of the two checker wrappers puts it on PATH.
    local host user
    host=$(< /proc/sys/kernel/hostname)
    user="${USER:-$(id -un)}"

    printf '%s\n' \
        "nixosConfigurations.$host.pkgs" \
        "homeConfigurations.$user@$host.pkgs" \
        "homeConfigurations.$user.pkgs" \
        "legacyPackages.$(uname -m)-linux"
}

# Reads the pin out of a package's own src. fetchFromGitHub and its siblings
# pass rev, tag and gitRepoUrl through to the fetched derivation, and those
# survive overrideAttrs - so what comes back is the pin the configuration
# actually builds, not whatever nixpkgs happens to ship.
#
# The whole probe is forced inside tryEval: a src that throws when evaluated is
# a package that cannot be checked, not a checker that crashes. Nothing is
# forced outside it, which is why the isAttrs test lives inside too.
#
# Sets PACKAGE_PIN rather than printing it, so that the resolved PACKAGE_BASE
# survives: called through a command substitution the memoisation would be
# written in a subshell and every later check would re-probe every candidate.
package_pin() {
    local attribute="$1"
    local base output

    PACKAGE_PIN=""

    while IFS= read -r base; do
        output=$(timeout "$PACKAGE_EVAL_TIMEOUT" nix eval --json \
            "$FLAKE_DIR#$base.$attribute" --apply '
                package:
                let
                  none = { rev = null; tag = null; repository = null; };
                  probe =
                    let src = package.src or null; in
                    if builtins.isAttrs src then {
                      rev = src.rev or null;
                      tag = src.tag or null;
                      repository = src.gitRepoUrl or null;
                    } else none;
                  result = builtins.tryEval (builtins.deepSeq probe probe);
                in
                if result.success then result.value else none
            ' 2>/dev/null) || continue
        [[ -n "$output" ]] || continue
        PACKAGE_BASE="$base"
        PACKAGE_PIN="$output"
        return 0
    done < <(package_bases)

    return 1
}

is_revision() {
    [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]]
}

# Sets CURRENT_VALUE rather than printing it. The package case has to report a
# derived repository and a specific failure alongside the value, and a command
# substitution runs in a subshell where those assignments would be discarded.
current_value() {
    local check="$1"
    local current_type
    current_type=$(jq -r '.current' <<<"$check")

    CURRENT_VALUE=""

    case "$current_type" in
        package)
            local attribute rev tag
            attribute=$(jq -r '.attribute // empty' <<<"$check")
            if [[ -z "$attribute" ]]; then
                CURRENT_ERROR="no package attribute configured"
                return 1
            fi

            if ! package_pin "$attribute"; then
                CURRENT_ERROR="package \"$attribute\" not found"
                return 1
            fi

            DERIVED_REPOSITORY=$(jq -r '.repository // empty' <<<"$PACKAGE_PIN")
            rev=$(jq -r '.rev // empty' <<<"$PACKAGE_PIN")
            tag=$(jq -r '.tag // empty' <<<"$PACKAGE_PIN")

            # A tarball or vendored src carries no pin at all. Reported rather
            # than skipped: silently passing would be indistinguishable from a
            # package that is genuinely up to date.
            if [[ -z "$rev" && -z "$tag" ]]; then
                CURRENT_ERROR="no revision in \"$attribute\" src"
                return 1
            fi

            # fetchFromGitHub writes the tag into rev as "refs/tags/v1.2.3"
            # when called with rev, and sets tag separately when called with
            # tag. Either way the comparable value is the bare tag.
            if [[ -n "$tag" ]]; then
                CURRENT_VALUE="$tag"
            else
                CURRENT_VALUE="${rev#refs/tags/}"
            fi
            ;;
        flake-input)
            local node
            node=$(flake_input_node "$(jq -r '.input' <<<"$check")") || return 1

            # A local path override - url = "path:/..." while a change is being
            # tested before it is pushed - locks to {path, narHash} and carries
            # neither rev nor ref. That is a property of the lock entry, not of
            # the source: the tree being built is a checkout with a HEAD, so the
            # revision is there to be read, just not out of flake.lock. Reading
            # it from the tree keeps the check working across an override,
            # instead of reporting a revision missing that plainly exists.
            local locked_type
            locked_type=$(jq -r '.locked.type // empty' <<<"$node")
            if [[ "$locked_type" == "path" ]]; then
                local locked_path
                locked_path=$(jq -r '.locked.path // empty' <<<"$node")
                if [[ "$(jq -r '.policy' <<<"$check")" == "tag" ]]; then
                    if ! worktree_tag "$locked_path"; then
                        CURRENT_ERROR="local path override has no tag at HEAD"
                        return 1
                    fi
                elif ! worktree_revision "$locked_path"; then
                    CURRENT_ERROR="local path override is not a git checkout"
                    return 1
                fi
                return 0
            elif [[ "$(jq -r '.policy' <<<"$check")" == "tag" ]]; then
                CURRENT_VALUE=$(jq -r '.original.ref // empty' <<<"$node")
            else
                CURRENT_VALUE=$(jq -r '.locked.rev // empty' <<<"$node")
                CURRENT_EPOCH=$(jq -r '.locked.lastModified // empty' <<<"$node")
            fi
            ;;
        local)
            local path
            path=$(jq -r '.path' <<<"$check")
            path=${path/#\~/$HOME}
            worktree_revision "$path"
            ;;
        revision)
            CURRENT_VALUE=$(jq -r '.revision // empty' <<<"$check")
            ;;
        tag)
            CURRENT_VALUE=$(jq -r '.tag // empty' <<<"$check")
            ;;
        *)
            return 1
            ;;
    esac
}

main() {
    # shown=1 so this actually reaches the tooltip. Callers render the Sources
    # section only when shown > 0, so reporting a broken configuration with
    # shown=0 would leave it looking identical to a clean check.
    if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$SOURCE_CHECKS_JSON"; then
        json_result 0 1 "Invalid sourceChecks configuration"
        return
    fi

    # Left silent on purpose: the callers already surface loss of network on
    # their own, and this is a transient condition rather than a broken config.
    if ! have_network; then
        json_result 0 0 "Sources not checked (no network)"
        return
    fi

    local count=0
    local shown=0
    local tooltip=""

    # Problems are reported rather than swallowed: without this a typo'd input
    # name, an unreachable repository and "everything up to date" all produced
    # an identical empty result, with no way to tell a passing check from a
    # broken one.
    add_line() {
        [[ -n "$tooltip" ]] && tooltip+="\n"
        tooltip+="$1"
        shown=$((shown + 1))
    }

    while IFS= read -r check; do
        local mode
        mode=$(jq -r '.mode' <<<"$check")
        [[ "$mode" == "disabled" ]] && continue

        local name repository policy ref current upstream current_type
        name=$(jq -r '.name' <<<"$check")
        repository=$(jq -r '.repository // empty' <<<"$check")
        policy=$(jq -r '.policy' <<<"$check")
        current_type=$(jq -r '.current' <<<"$check")

        DERIVED_REPOSITORY=""
        CURRENT_ERROR="current revision not found"
        CURRENT_DIRTY=false
        CURRENT_EPOCH=""
        if ! current_value "$check" || [[ -z "$CURRENT_VALUE" || "$CURRENT_VALUE" == "null" ]]; then
            add_line "$name ($CURRENT_ERROR)"
            continue
        fi
        current="$CURRENT_VALUE"

        # A check may name its own repository - forks are the whole reason to
        # track an upstream other than the one the package fetches from - and
        # only falls back to the one read out of the package when it does not.
        [[ -n "$repository" && "$repository" != "null" ]] || repository="$DERIVED_REPOSITORY"
        if [[ -z "$repository" ]]; then
            add_line "$name (no upstream repository configured)"
            continue
        fi

        # "file:/path", with one slash, is what nix writes for a local source
        # and what gets copied out of a flake.lock into a check by hand. git
        # reads it as an ssh target - resolving a host called "file:" - and
        # fails on a directory it could read perfectly well.
        #
        # Repaired rather than reported, which is the opposite of how the
        # checks below treat a bad policy, and for a reason: those are
        # reported because two different repairs are plausible and picking one
        # would be guessing at intent. This has a single possible reading, and
        # the form never works, so normalising it cannot mask a mistake or
        # change what a working configuration does. The rule is "do not
        # guess", not "do not repair".
        #
        # Applied after the fallback above, so a repository derived from a
        # package's own src gets the same treatment as a configured one.
        case "$repository" in
            file:///*) repository="${repository#file://}" ;;
            file:/*)   repository="${repository#file:}" ;;
        esac

        # The comparison below is only meaningful when both sides are the same
        # kind of thing: a branch policy resolves upstream to a commit, a tag
        # policy to a tag name, and a commit never equals a tag name. A check
        # whose current value has the wrong shape therefore reports an update
        # on every single run, forever, and no rebuild can ever clear it.
        #
        # Applied to hand-written pins as well as derived ones. That the policy
        # beside a hand-written pin was also chosen by hand makes the pairing
        # deliberate, not correct - the two combinations caught here have no
        # reading under which the comparison does what the user meant, so this
        # reports a stated intent that cannot be carried out rather than
        # silently carrying out something else. The check is skipped for
        # flake-input, which picks its current value from the policy and is
        # consistent by construction.
        if [[ "$current_type" != "flake-input" ]]; then
            if [[ "$policy" == "branch" ]] && ! is_revision "$current"; then
                add_line "$name (branch policy needs a revision, got \"$current\")"
                continue
            fi
            if [[ "$policy" == "tag" ]] && is_revision "$current"; then
                add_line "$name (tag policy needs a tag, got a revision)"
                continue
            fi
        fi

        case "$policy" in
            branch)
                ref=$(jq -r '.ref // "HEAD"' <<<"$check")
                [[ "$ref" == "null" ]] && ref="HEAD"
                upstream=$(remote_revision "$repository" "$ref")
                ;;
            tag)
                local tags
                tags=$(remote_tags "$repository")
                if [[ -z "$tags" ]]; then
                    add_line "$name (upstream unreachable)"
                    continue
                fi

                # The shape guard above rules out a commit, but a tag policy
                # can still be handed something that merely looks like a tag
                # and is not one: a branch name from a flake input's ref, an
                # abbreviated revision, a tag that was renamed or deleted
                # upstream, or a typo. Each compares unequal to every real tag
                # forever, which is the same permanent phantom update in a
                # shape no syntactic test can catch. The list is already here,
                # so ask it. Matched against every tag rather than the ones
                # tagPattern admits, so that deliberately moving between
                # release lines is not mistaken for a broken check.
                if ! grep -qxF -- "$current" <<<"$tags"; then
                    add_line "$name (\"$current\" is not a tag upstream)"
                    continue
                fi

                upstream=$(latest_tag \
                    "$tags" \
                    "$(jq -r '.tagPattern // "*"' <<<"$check")" \
                    "$(jq -c '.excludeTagPatterns // []' <<<"$check")")
                ;;
            *)
                add_line "$name (unknown policy \"$policy\")"
                continue
                ;;
        esac

        if [[ -z "$upstream" ]]; then
            add_line "$name (upstream unreachable)"
            continue
        fi

        # Equal revisions mean there is no update to report - but a working tree
        # with uncommitted changes is not actually at the revision it claims, so
        # going silent there would say "current" about something that was built
        # from code existing in no commit at all. Not counted either way: there
        # is nothing upstream to move to, which is the thing a count is for.
        #
        # The current value is abbreviated for a revision and left whole for a
        # tag: a tag name is already what a human would call the version, and
        # cutting it to seven characters turns "v1.2.3-rc1" into "v1.2.3-",
        # which is what this line used to do.
        if [[ "$current" == "$upstream" ]]; then
            if [[ "$CURRENT_DIRTY" == true ]]; then
                local at="$current"
                [[ "$policy" == "tag" ]] || at="${current:0:7}"
                add_line "$name: $at, uncommitted local changes"
            fi
            continue
        fi

        # The qualifier rides on the current side, which is the side it is true
        # of: the tree is that revision plus changes that are not in it.
        local note=""
        [[ "$CURRENT_DIRTY" == true ]] && note="+ uncommitted"

        case "$policy" in
            tag)
                # No date enrichment for a tag policy, deliberately. A release
                # name is already the most legible thing either side could be
                # called, so replacing it with the day it was cut would cost
                # information rather than add it - and dating a tag means
                # resolving it to a commit first, which is a round trip spent
                # making the line worse.
                local note_suffix=""
                [[ -n "$note" ]] && note_suffix=" $note"
                # Always counted. Two different tag names mean a different
                # release is out, which is actionable whichever way round the
                # version numbers happen to sort.
                [[ "$mode" == "count" ]] && count=$((count + 1))
                add_line "$name: $current$note_suffix → $upstream"
                ;;
            *)
                # Dates and distance where they can be had, abbreviated
                # revisions where they cannot. Failure lines above keep their
                # "name (reason)" shape on purpose: a finding and a check that
                # could not be made should not read as the same kind of
                # statement.
                #
                # CURRENT_EPOCH is whatever could be read locally - a working
                # tree's own history, or the lock's lastModified - and empty
                # for a hand-written pin or a package src, which have no local
                # source for it and fall back to one more API call.
                # Counted on the renderer's verdict rather than on the
                # revisions merely differing. It exits 10 for a current
                # revision that is strictly ahead - a fork with nothing to
                # pull - and a count there would put a number on the waybar
                # for work that does not exist, which no rebuild can clear.
                # Shown either way: the two sides do differ, and that is worth
                # knowing even when there is nothing to do about it.
                local line status=0
                line=$(format-upstream-line \
                    "$name" "$repository" "$current" "$upstream" \
                    "$CURRENT_EPOCH" "$note") || status=$?
                [[ "$mode" == "count" && "$status" -ne 10 ]] && count=$((count + 1))
                add_line "$line"
                ;;
        esac
    done < <(jq -c '.[]' <<<"$SOURCE_CHECKS_JSON")

    json_result "$count" "$shown" "$tooltip"
}

main
