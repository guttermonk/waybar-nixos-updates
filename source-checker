#!/usr/bin/env bash

# Optional source-provenance checker for revisions that ordinary package and
# flake-input checks cannot interpret without an explicit upstream policy.

set -u

FLAKE_DIR="${FLAKE_DIR:-${NIXOS_CONFIG_PATH:-$HOME/.config/nixos}}"
# Deliberately ${VAR-default}, not ${VAR:-default}: only an *unset* value means
# "no checks configured". An empty value is a broken one, and must fall through
# to the validation below rather than being silently read as an empty list.
SOURCE_CHECKS_JSON="${SOURCE_CHECKS_JSON-[]}"

# Per-repository ceiling for git ls-remote. These run serially, one or more per
# configured check, inside the lock held by the background worker - an unbounded
# call against a slow or unreachable remote would stall every later check.
# ls-remote against a large repository (nixpkgs) measures around 46s, so the
# default leaves headroom without being open-ended.
SOURCE_CHECK_TIMEOUT="${SOURCE_CHECK_TIMEOUT:-60}"

json_result() {
    jq -cn --argjson count "$1" --argjson shown "$2" --arg tooltip "$3" \
        '{count: $count, shown: $shown, tooltip: $tooltip}'
}

have_network() {
    ip route 2>/dev/null | grep -q "^default"
}

# Wraps git ls-remote with a timeout and no credential prompting.
ls_remote() {
    GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="" \
        timeout "$SOURCE_CHECK_TIMEOUT" git ls-remote "$@" 2>/dev/null
}

remote_revision() {
    local repository="$1"
    local ref="$2"
    local remote_ref="$ref"
    [[ "$ref" == "HEAD" ]] || remote_ref="refs/heads/$ref"
    ls_remote "$repository" "$remote_ref" | awk 'NR == 1 { print $1 }'
}

latest_tag() {
    local repository="$1"
    local include_pattern="$2"
    local excluded_json="$3"

    ls_remote --tags --refs "$repository" \
        | awk '{ sub("refs/tags/", "", $2); print $2 }' \
        | while IFS= read -r tag; do
            [[ "$tag" == $include_pattern ]] || continue
            excluded=false
            while IFS= read -r pattern; do
                if [[ "$tag" == $pattern ]]; then
                    excluded=true
                    break
                fi
            done < <(jq -r '.[]' <<<"$excluded_json")
            [[ "$excluded" == false ]] && printf '%s\n' "$tag"
        done \
        | sort -V \
        | tail -n 1
}

flake_input_node() {
    local input="$1"
    jq -c --arg input "$input" '
        . as $lock
        | $lock.nodes.root.inputs[$input] as $reference
        | if ($reference | type) == "array" then $reference[0] else $reference end
        | $lock.nodes[.]
    ' "$FLAKE_DIR/flake.lock" 2>/dev/null
}

current_value() {
    local check="$1"
    local current_type
    current_type=$(jq -r '.current' <<<"$check")

    case "$current_type" in
        flake-input)
            local node
            node=$(flake_input_node "$(jq -r '.input' <<<"$check")") || return 1
            if [[ "$(jq -r '.policy' <<<"$check")" == "tag" ]]; then
                jq -r '.original.ref // empty' <<<"$node"
            else
                jq -r '.locked.rev // empty' <<<"$node"
            fi
            ;;
        local)
            local path
            path=$(jq -r '.path' <<<"$check")
            path=${path/#\~/$HOME}
            git -C "$path" rev-parse HEAD 2>/dev/null
            ;;
        revision)
            jq -r '.revision // empty' <<<"$check"
            ;;
        tag)
            jq -r '.tag // empty' <<<"$check"
            ;;
        *)
            return 1
            ;;
    esac
}

main() {
    # shown=1 so this actually reaches the tooltip. Callers render the Sources
    # section only when shown > 0, so reporting a broken configuration with
    # shown=0 would leave it looking identical to a clean check.
    if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$SOURCE_CHECKS_JSON"; then
        json_result 0 1 "Invalid sourceChecks configuration"
        return
    fi

    # Left silent on purpose: the callers already surface loss of network on
    # their own, and this is a transient condition rather than a broken config.
    if ! have_network; then
        json_result 0 0 "Sources not checked (no network)"
        return
    fi

    local count=0
    local shown=0
    local tooltip=""

    # Problems are reported rather than swallowed: without this a typo'd input
    # name, an unreachable repository and "everything up to date" all produced
    # an identical empty result, with no way to tell a passing check from a
    # broken one.
    add_line() {
        [[ -n "$tooltip" ]] && tooltip+="\n"
        tooltip+="$1"
        shown=$((shown + 1))
    }

    while IFS= read -r check; do
        local mode
        mode=$(jq -r '.mode' <<<"$check")
        [[ "$mode" == "disabled" ]] && continue

        local name repository policy ref current upstream
        name=$(jq -r '.name' <<<"$check")
        repository=$(jq -r '.repository' <<<"$check")
        policy=$(jq -r '.policy' <<<"$check")

        if ! current=$(current_value "$check") || [[ -z "$current" || "$current" == "null" ]]; then
            add_line "$name (current revision not found)"
            continue
        fi

        case "$policy" in
            branch)
                ref=$(jq -r '.ref // "HEAD"' <<<"$check")
                [[ "$ref" == "null" ]] && ref="HEAD"
                upstream=$(remote_revision "$repository" "$ref")
                ;;
            tag)
                upstream=$(latest_tag \
                    "$repository" \
                    "$(jq -r '.tagPattern // "*"' <<<"$check")" \
                    "$(jq -c '.excludeTagPatterns // []' <<<"$check")")
                ;;
            *)
                add_line "$name (unknown policy \"$policy\")"
                continue
                ;;
        esac

        if [[ -z "$upstream" ]]; then
            add_line "$name (upstream unreachable)"
            continue
        fi

        [[ "$current" != "$upstream" ]] || continue
        [[ "$mode" == "count" ]] && count=$((count + 1))
        if [[ "$policy" == "tag" ]]; then
            add_line "$name ($current → $upstream)"
        else
            add_line "$name (${current:0:7} → ${upstream:0:7})"
        fi
    done < <(jq -c '.[]' <<<"$SOURCE_CHECKS_JSON")

    json_result "$count" "$shown" "$tooltip"
}

main
