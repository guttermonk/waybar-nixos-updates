        . as $root |
        $root.nodes.root.inputs | to_entries[] |
        select(.value | type == "string") |
        {name: .key, node: $root.nodes[.value]} |
        select(.node.locked.type == "git") |
        select(.node.original.rev != null) |
        [.name, .node.locked.url, .node.locked.rev,
         (.node.locked.ref // "HEAD"), (.node.locked.lastModified | tostring)] |
        @tsv
    ' "$flake_lock")

    echo "$count" > "$PINNED_STATE_FILE"

    echo "$tooltip" > "$PINNED_TOOLTIP_FILE"
    
    return 0
}

run_checks() {
    local input_count=0
    local input_tooltip=""
    local input_count_for_total=0
    
    local pinned_count=0
    local pinned_tooltip=""
    local pinned_count_for_total=0
    
    # Check unpinned inputs based on mode
    if [ "$INPUT_CHECKER_MODE" != "disabled" ]; then
        check_unpinned_inputs
        input_count=$(cat "$INPUT_STATE_FILE" 2>/dev/null || echo "0")
        input_tooltip=$(cat "$INPUT_TOOLTIP_FILE" 2>/dev/null || echo "")
        if [ "$INPUT_CHECKER_MODE" = "count" ]; then
            input_count_for_total=$input_count
        fi
    fi
    
    # Check pinned inputs based on mode
    if [ "$INPUT_CHECKER_PINNED" != "disabled" ]; then
        check_pinned_inputs
        pinned_count=$(cat "$PINNED_STATE_FILE" 2>/dev/null || echo "0")
        pinned_tooltip=$(cat "$PINNED_TOOLTIP_FILE" 2>/dev/null || echo "")
        if [ "$INPUT_CHECKER_PINNED" = "count" ]; then
            pinned_count_for_total=$pinned_count
        fi
    fi
    
    # Calculate total count
    local total_count=$((input_count_for_total + pinned_count_for_total))
    echo "$total_count" > "$STATE_FILE"
    echo "$(date +%s)" > "$LAST_RUN_FILE"
    
    # Build tooltip
    local final_tooltip=""
    
    # Labelled whether or not a Pinned section follows it. The heading used to
    # appear only alongside one, on the reasoning that a lone section needs no
    # name - but the lone section is the common case, and unlabelled lines left
    # the reader to infer that flake inputs were what they were looking at.
    #
    # Keyed on there being lines, not on the count being non-zero. The two came
    # apart once an unreachable remote became something to report: it is a line
    # with no count behind it, and a section gated on the count would have
    # dropped it the same way the loops used to.
    if [ "$INPUT_CHECKER_MODE" != "disabled" ] && [ -n "$input_tooltip" ]; then
        final_tooltip="Inputs:\\n$input_tooltip"
    fi

    if [ "$INPUT_CHECKER_PINNED" != "disabled" ] && [ -n "$pinned_tooltip" ]; then
        if [ -n "$final_tooltip" ]; then
            final_tooltip="$final_tooltip\\n\\nPinned:\\n$pinned_tooltip"
        else
            final_tooltip="Pinned:\\n$pinned_tooltip"
        fi
    fi
    
    if [ -z "$final_tooltip" ]; then
        echo "All inputs up to date" > "$LAST_RUN_TOOLTIP"
    else
        echo "$final_tooltip" > "$LAST_RUN_TOOLTIP"
    fi
    
    return 0
}

# ===== Main =====
updates=$(cat "$STATE_FILE" 2>/dev/null || echo "0")
last_run=$(cat "$LAST_RUN_FILE" 2>/dev/null || echo "0")
current_time=$(date +%s)

# Check if input checking is completely disabled
if [ "$INPUT_CHECKER_MODE" = "disabled" ] && [ "$INPUT_CHECKER_PINNED" = "disabled" ]; then
    output_json "0" "updated" "Input checking disabled"
    exit 0
fi

# If flake inputs were updated, force a re-check regardless of interval
if [ -f "$INPUT_UPDATE_FLAG" ]; then
    rm -f "$INPUT_UPDATE_FLAG"
    rm -f "$LAST_RUN_FILE"
    last_run=0
fi

if [ $((current_time - last_run)) -gt "$UPDATE_INTERVAL" ]; then
    # Every check below is a network round trip, so with no route there is
    # nothing to find out and the last result stands. Skipped rather than
    # attempted, because attempting it would have every input report its
    # upstream unreachable at once - turning one fact, that the link is down,
    # into a list as long as the inputs. The two wrapper checkers answer a
    # missing route the same way, well before they reach their input loops.
    #
    # LAST_RUN_FILE is deliberately not stamped: nothing was checked, so the
    # next poll should try again rather than wait out another interval.
    if ! have_network; then
        tooltip=$(cat "$LAST_RUN_TOOLTIP" 2>/dev/null || echo "")
        if [ "$updates" -ne 0 ] 2>/dev/null && [ -n "$tooltip" ]; then
            output_json "$updates" "has-updates" "$tooltip"
        else
            output_json "$updates" "updated" "Inputs not checked (no network)"
        fi
        exit 0
    fi

    if run_checks; then
        updates=$(cat "$STATE_FILE" 2>/dev/null || echo "0")
    else
        output_json "?" "error" "Input check failed"
        exit 0
    fi
fi

# The tooltip is shown whatever the count is, because the two are no longer the
# same question: "nothing to apply" and "nothing to report" came apart once an
# unreachable remote became a line without a count. Reading the stored text and
# only falling back when there is none keeps an unreachable-only result
# visible, where the old "count is zero, so say all up to date" discarded it.
tooltip=$(cat "$LAST_RUN_TOOLTIP" 2>/dev/null || echo "")
[ -n "$tooltip" ] || tooltip="All inputs up to date"

if [ "$updates" -ne 0 ] 2>/dev/null; then
    output_json "$updates" "has-updates" "$tooltip"
else
    output_json "0" "updated" "$tooltip"
fi
