#!/usr/bin/env bash

# Flake Input Checker for Waybar
# Compares locked flake input revisions against upstream using git ls-remote.
# Runs in seconds — no nix evaluation or builds required.
#
# Checks each GitHub input in flake.lock against its tracked branch.
# Supports both unpinned and pinned inputs with configurable modes.

# ===== Configuration =====
FLAKE_DIR="${FLAKE_DIR:-$HOME/.config/nixos}"
UPDATE_INTERVAL="${UPDATE_INTERVAL:-3599}"
CACHE_DIR="${CACHE_DIR:-$HOME/.cache}"

# Mode: "disabled" | "show" | "count"
#   - disabled: Don't check inputs
#   - show: Check and show in tooltip, but don't include in count
#   - count: Check, show in tooltip, and include in waybar count
INPUT_CHECKER_MODE="${INPUT_CHECKER_MODE:-count}"
INPUT_CHECKER_PINNED="${INPUT_CHECKER_PINNED:-disabled}"

# The INPUT_UPDATE_FLAG signals that flake inputs were updated (e.g. nix flake update).
# Forces an immediate re-check. Add this to any alias that runs nix flake update:
# touch "$HOME/.cache/nix-update-input-update-flag" && pkill -x -RTMIN+12 .waybar-wrapped
INPUT_UPDATE_FLAG="$CACHE_DIR/nix-update-input-update-flag"

STATE_FILE="$CACHE_DIR/nix-update-input-state"
LAST_RUN_FILE="$CACHE_DIR/nix-update-input-last-run"
LAST_RUN_TOOLTIP="$CACHE_DIR/nix-update-input-tooltip"
INPUT_STATE_FILE="$CACHE_DIR/nix-update-input-state"
INPUT_TOOLTIP_FILE="$CACHE_DIR/nix-update-input-tooltip"
PINNED_STATE_FILE="$CACHE_DIR/nix-update-pinned-state"
PINNED_TOOLTIP_FILE="$CACHE_DIR/nix-update-pinned-tooltip"

# ===== Initialize =====
mkdir -p "$CACHE_DIR"
[ -f "$STATE_FILE" ] || echo "0" > "$STATE_FILE"
[ -f "$LAST_RUN_FILE" ] || echo "0" > "$LAST_RUN_FILE"
[ -f "$LAST_RUN_TOOLTIP" ] || echo "All inputs up to date" > "$LAST_RUN_TOOLTIP"

output_json() {
    echo "{ \"text\":\"$1\", \"alt\":\"$2\", \"tooltip\":\"$3\" }"
}

# A default route, which is as much as can be established cheaply and is enough
# to tell "the link is down" from "this one remote did not answer". The same
# test source-checker uses, for the same reason.
have_network() {
    ip route 2>/dev/null | grep -q "^default"
}

# Lines are rendered by format-upstream-line, which is shared with the other
# two checkers and with source-checker so that one grammar is written down
# once. lastModified is passed along because flake.lock already records it:
# that is the current side's date for free, and one fewer thing to ask the
# network for.

check_unpinned_inputs() {
    local flake_lock="$FLAKE_DIR/flake.lock"
    [[ ! -f "$flake_lock" ]] && return 1

    local count=0
    local tooltip=""

    # Check GitHub inputs (unpinned)
    while IFS=$'\t' read -r name owner repo rev ref last_modified; do
        local remote_ref
        [[ "$ref" == "HEAD" ]] && remote_ref="HEAD" || remote_ref="refs/heads/$ref"

        local latest
        latest=$(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="" git ls-remote \
            "https://github.com/$owner/$repo" "$remote_ref" 2>/dev/null | cut -f1)

        if [[ -z "$latest" ]]; then
            # Reported rather than skipped. Going silent made an unreachable
            # remote indistinguishable from an input that is up to date: the
            # input simply left the section and the count, which reads as
            # "nothing to do here" when the truth is "nobody knows".
            #
            # Not counted, though. A count is for updates there are to apply,
            # and whether this input has one is exactly what failed to be
            # established - so it is shown without being added up.
            [[ -n "$tooltip" ]] && tooltip+="\\n"
            tooltip+="$name (upstream unreachable)"
        elif [[ "$latest" != "$rev" ]]; then
            # Counted on the renderer's verdict, not on the revisions merely
            # differing: it exits 10 when the locked revision is strictly
            # ahead of the tracked branch, which has nothing to update to.
            # Reachable for a pinned input aimed at a commit that is not on
            # its branch - a not-yet-merged tip - and counting that put a
            # number on the waybar that no rebuild could clear.
            local line status=0
            line=$(format-upstream-line "$name" \
                "https://github.com/$owner/$repo" "$rev" "$latest" "$last_modified") || status=$?
            [[ "$status" -ne 10 ]] && count=$((count + 1))
            [[ -n "$tooltip" ]] && tooltip+="\\n"
            tooltip+="$line"
        fi
    done < <(jq -r '
        . as $root |
        $root.nodes.root.inputs | to_entries[] |
        select(.value | type == "string") |
        {name: .key, node: $root.nodes[.value]} |
        select(.node.locked.type == "github") |
        select(.node.original.rev == null) |
        [.name, .node.original.owner, .node.original.repo, .node.locked.rev,
         (.node.original.ref // "HEAD"), (.node.locked.lastModified | tostring)] |
        @tsv
    ' "$flake_lock")

    # Check generic git inputs (Bitbucket, GitLab, self-hosted, etc.) - unpinned
    while IFS=$'\t' read -r name url rev ref last_modified; do
        local remote_ref="$ref"

        # nix writes a local input's url as "file:/path", with one slash. git
        # reads that as an ssh target and tries to resolve a host called
        # "file:", so the check failed on a directory it could have read
        # perfectly well - silently before, and as "upstream unreachable"
        # once that became something to report. Neither was true, so the
        # scheme is stripped to the plain path git does accept.
        case "$url" in
            file:///*) url="${url#file://}" ;;
            file:/*)   url="${url#file:}" ;;
        esac

        # A bare ref name matches refs/heads, refs/tags and the
        # refs/remotes/origin copy a local clone carries, so the listing can
        # hold more than one line. Keeping all of them compared a multi-line
        # string against a single revision - unequal forever, which reads as
        # an update no rebuild can clear. The branch is preferred; the first
        # line serves for a ref that is not a branch, such as a tag.
        local latest="" first="" sha refname
        while IFS=$'\t' read -r sha refname; do
            [[ -n "$sha" ]] || continue
            [[ -n "$first" ]] || first="$sha"
            [[ "$refname" == "refs/heads/$remote_ref" ]] && { latest="$sha"; break; }
        done < <(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="" git ls-remote \
                     "$url" "$remote_ref" 2>/dev/null)
        [[ -n "$latest" ]] || latest="$first"

        if [[ -z "$latest" ]]; then
            [[ -n "$tooltip" ]] && tooltip+="\\n"
            tooltip+="$name (upstream unreachable)"
        elif [[ "$latest" != "$rev" ]]; then
            local line status=0
            line=$(format-upstream-line "$name" \
                "$url" "$rev" "$latest" "$last_modified") || status=$?
            [[ "$status" -ne 10 ]] && count=$((count + 1))
            [[ -n "$tooltip" ]] && tooltip+="\\n"
            tooltip+="$line"
        fi
    done < <(jq -r '
        . as $root |
        $root.nodes.root.inputs | to_entries[] |
        select(.value | type == "string") |
        {name: .key, node: $root.nodes[.value]} |
        select(.node.locked.type == "git") |
        select(.node.original.rev == null) |
        [.name, .node.locked.url, .node.locked.rev,
         (.node.locked.ref // "HEAD"), (.node.locked.lastModified | tostring)] |
        @tsv
    ' "$flake_lock")

    echo "$count" > "$INPUT_STATE_FILE"

    # Written whatever the count is. An unreachable remote produces a line
    # without producing a count, and discarding the text whenever the count
    # was zero threw away exactly those lines.
    echo "$tooltip" > "$INPUT_TOOLTIP_FILE"
    
    return 0
}

